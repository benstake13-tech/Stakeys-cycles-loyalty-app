# Shop Assistant and AI features use the Supabase gemini-gateway function.
# Set GEMINI_API_KEY in Supabase Dashboard > Edge Functions > Secrets.
# A Vercel env variable or VITE_GEMINI_API_KEY does not configure this function.
# Do not embed the Gemini secret in browser/APK builds.
# Optional model override: set GEMINI_MODEL in the same Supabase secrets store.

# Supabase Cloud Configuration (Required for Cross-Device & Realtime Sync)
VITE_SUPABASE_URL="https://lhojocpygcnkxvkrcuxh.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imxob2pvY3B5Z2Nua3h2a3JjdXhoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAyNzU2MTYsImV4cCI6MjEwNTg1MTYxNn0.RuSrHufSCEd3bwOzF3kYD5MKx9gI1TKK9apF3HWJeZ8"

# ---------------------------------------------------------------------------
# Native app API base (Android / iOS builds only).
# The packaged app (Capacitor) serves its bundled assets from a local WebView
# origin, so relative `/api/*` calls would be answered by the asset bundle (404)
# instead of the network. Set this to the deployed API origin when building the
# native bundle so every `/api/*` call becomes absolute. Leave UNSET for web
# builds (Vercel) and local dev — those keep same-origin relative calls.
# Injected automatically by the `android:sync` / `ios:sync` npm scripts.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=""

# ---------------------------------------------------------------------------
# OneSignal Web Push (real push notifications to staff/customer phones)
# App ID is safe to expose to the browser; the REST API key is server-only.
# Dashboard: https://dashboard.onesignal.com/  (Settings > Keys & IDs)
# Devices attached to the workshop Gmail are tagged with owner_email so the
# 24-hour reminder can reach them (see src/utils/pushNotifications.ts).
# ---------------------------------------------------------------------------
VITE_ONESIGNAL_APP_ID="7f67ab94-3c85-4702-9cd8-d158cf294593"
ONESIGNAL_APP_ID="7f67ab94-3c85-4702-9cd8-d158cf294593"

# Server-only secret. Required for pushes that land when the app is closed.
# Never exposed to the browser. Get it from OneSignal > Settings > Keys & IDs.
# Any of these names is accepted server-side:
#   ONESIGNAL_REST_API_KEY  |  ONESIGNAL_API_KEY  |  VITE_ONESIGNAL_REST_API_KEY
#
# IMPORTANT: a `VITE_`-prefixed key is inlined into the public browser bundle IF
# any client code reads `import.meta.env` dynamically. This repo reads env values
# only through literal `import.meta.env.VITE_X` accesses (see oauthService.ts),
# so no VITE_ secret is inlined — but the safest choice is the un-prefixed name
# ONESIGNAL_REST_API_KEY. Verify after a build with:
#   grep -r "os_v2_app" dist/   # must print nothing
ONESIGNAL_REST_API_KEY="YOUR_ONESIGNAL_REST_API_KEY"
VITE_ONESIGNAL_REST_API_KEY="YOUR_ONESIGNAL_REST_API_KEY"

# Admin inbox: every workshop booking/system push is addressed to the devices
# tagged with this email (set automatically for admin/staff on sign-in). Set the
# same value in Vercel so staff phones are tagged correctly.
VITE_ADMIN_NOTIFICATION_EMAIL="stakeyscycle95@gmail.com"

# Optional: overrides the origin a push opens when tapped. When unset the
# deployed function derives it from the request host (your live domain).
APP_ORIGIN=""

# Origin of the staff app that staff push notifications must open (so a booking
# made on the website or customer app still deep-links to the workshop
# terminal). Defaults to https://www.stakeys-cycles.co.uk when unset.
VITE_STAFF_APP_ORIGIN="https://www.stakeys-cycles.co.uk"

# ---------------------------------------------------------------------------
# Business performance OAuth (staff area "Growth" tab)
# Client IDs are used in the browser; secrets are used server-side only.
# Google: https://console.cloud.google.com/apis/credentials
#   Enable "Business Profile Performance API" + "My Business Account Management API"
# Meta:   https://developers.facebook.com/apps/
#   Add Facebook Login + Graph API; request pages_read_engagement, read_insights
#   Add ${origin}/oauth/callback (per surface origin) to Valid OAuth Redirect URIs.
# On Vercel, set VITE_META_APP_ID + META_APP_SECRET (and VITE_GOOGLE_CLIENT_ID +
# GOOGLE_CLIENT_SECRET) in each project's Environment Variables. The OAuth token
# exchange and insights proxy run from /api/oauth/* and /api/business/insights.
# ---------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"

VITE_META_APP_ID="YOUR_META_APP_ID"
META_APP_SECRET="YOUR_META_APP_SECRET"

# Meta static token (no-login path). A Business Manager SYSTEM-USER token lets
# the Growth tab read Page insights with NO Facebook popup. It is server-only
# and never sent to the browser; when set, Meta shows "Server linked" and the
# Authorise button is replaced by Refresh. Get it from Business Settings >
# Users > System Users > Generate Token (needs read_insights + pages_read_engagement).
# With this set you do NOT need VITE_META_APP_ID / META_APP_SECRET / the popup.
META_SYSTEM_USER_TOKEN="YOUR_META_SYSTEM_USER_TOKEN"

# Google Drive image catalogue (stock / gallery / advert folders).
# Folders must be shared publicly; the key needs the Drive API enabled and
# stays server-side (never exposed to the browser).
GOOGLE_DRIVE_API_KEY="YOUR_GOOGLE_DRIVE_API_KEY"

# Optional per-surface overrides for the three Drive folders.
VITE_DRIVE_STOCK_FOLDER=""
VITE_DRIVE_GALLERY_FOLDER=""
VITE_DRIVE_PROMO_FOLDER=""

# Google Business Profile proxy (Business tab). Server-only; the key never
# reaches the browser. Falls back as the Drive API key when the dedicated one
# is unset.
GOOGLE_BUSINESS_API_KEY="YOUR_GOOGLE_BUSINESS_API_KEY"

# ------------------------------------------------------------------ *
# Wallet passes (customer "Add to Wallet")
#
# Both providers are OFF until the matching server-only secrets are set;
# the /api/wallet/config endpoint reports which are configured and the client
# hides any button that would otherwise be dead. Signing material must NEVER
# be committed or bundled — set these in the host's environment only.
# ------------------------------------------------------------------ *

# Apple Wallet: a Pass Type ID signing identity exported as a password-
# protected .p12, then base64-encoded:
#   base64 -w0 PassTypeID.p12
APPLE_PASS_TYPE_ID="pass.com.yourdomain.loyalty"
APPLE_TEAM_ID="YOUR_APPLE_TEAM_ID"
APPLE_PASS_CERT_P12="<base64 of the .p12>"
APPLE_PASS_CERT_PASSWORD="<the .p12 password>"
# Optional PEM bundle of the Apple WWDR intermediate certificate(s), so the
# pass validates against the real Apple chain. Required in production.
APPLE_WWDR_CERT_PEM=""

# Google Wallet: an Issuer account + a service-account key.
GOOGLE_WALLET_ISSUER_ID="3388000000000000000"
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL="wallet@your-project.iam.gserviceaccount.com"
# The service account's PEM private key (newlines may be literal \n).
GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional; defaults to <issuerId>.stakeys_loyalty.
GOOGLE_WALLET_CLASS_ID=""
SUMUP_API_KEY="YOUR_SUMUP_API_KEY"
SUMUP_MERCHANT_CODE="YOUR_SUMUP_MERCHANT_CODE"
# Tap to Pay (softPOS) via the Payment Switch — the free-tier path. Only this
# key is needed for tap-to-pay; no REST key or reader required.
SUMUP_AFFILIATE_KEY="YOUR_SUMUP_AFFILIATE_KEY"
# The application identifier the affiliate key was created against (must match).
SUMUP_APP_ID=""
SUMUP_READER_ID=""
SUMUP_CURRENCY="GBP"
