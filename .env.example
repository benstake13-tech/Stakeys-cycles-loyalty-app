# ---------------------------------------------------------------------------
# PushEngage Web Push (real push notifications to staff/customer phones)
# App ID is safe to expose to the browser; the API key is server-only.
# Dashboard: https://app.pushengage.com/  (Site Settings > Installation Settings)
# ---------------------------------------------------------------------------
VITE_PUSHENGAGE_APP_ID="23a65358-7d1f-4b0b-beff-de8b48f9689f"
PUSHENGAGE_APP_ID="23a65358-7d1f-4b0b-beff-de8b48f9689f"

# Server-only secret. Required for pushes that land when the app is closed.
# Never exposed to the browser. Get it from PushEngage > Site Settings > API Keys.
PUSHENGAGE_API_KEY="YOUR_PUSHENGAGE_API_KEY"

# ---------------------------------------------------------------------------
# Business performance OAuth (staff area "Growth" tab)
# Client IDs are used in the browser; secrets are used server-side only.
# Google: https://console.cloud.google.com/apis/credentials
#   Enable "Business Profile Performance API" + "My Business Account Management API"
# Meta:   https://developers.facebook.com/apps/
#   Add Facebook Login + Graph API; request pages_read_engagement, read_insights
# ---------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"

VITE_META_APP_ID="YOUR_META_APP_ID"
META_APP_SECRET="YOUR_META_APP_SECRET"
