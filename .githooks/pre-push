#!/usr/bin/env bash
# Opt-in local guard (enable with: git config core.hooksPath .githooks).
# Blocks a push that:
#   - sends a surface branch to 'main',
#   - would create a merge commit on a surface branch,
#   - leaves the three surface branches out of parity.
set -u
BRANCHES=(staff-terminal customer-app main-website)

while read -r local_ref local_sha remote_ref remote_sha; do
  remote_branch="${remote_ref#refs/heads/}"

  if [ "$remote_branch" = "main" ]; then
    echo "pre-push: refusing to push a surface branch to 'main'." >&2
    exit 1
  fi

  is_surface=0
  for b in "${BRANCHES[@]}"; do [ "$b" = "$remote_branch" ] && is_surface=1; done
  [ "$is_surface" -eq 1 ] || continue

  merges="$(git rev-list --merges --count "$local_sha" 2>/dev/null || echo 0)"
  if [ "$merges" != "0" ]; then
    echo "pre-push: $remote_branch contains merge commits; surface branches must stay linear." >&2
    exit 1
  fi
done

if ! bash scripts/check-parity.sh >/dev/null; then
  echo "pre-push: three-branch parity check failed — run 'npm run check:parity' for details." >&2
  exit 1
fi

if ! bash scripts/check-history.sh >/dev/null; then
  echo "pre-push: three-branch history check failed — run 'npm run check:history' for details." >&2
  exit 1
fi
exit 0
